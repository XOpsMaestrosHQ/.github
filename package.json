{
  "name": "xops-maestros-github-profile",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.6",
  "description": "XOps Maestros GitHub organization profile and community health files.",
  "scripts": {
    "prepare": "husky || true",
    "format": "prettier --write \"**/*.md\"",
    "format:check": "prettier --check \"**/*.md\"",
    "security:forbidden-patterns": "bash scripts/forbidden-pattern-scan.sh",
    "commitlint": "commitlint --edit"
  },
  "lint-staged": {
    "*.md": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3"
  }
}
